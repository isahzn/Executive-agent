# Copy to .env.local and fill in with YOUR own values. NEVER commit real keys.
#
# Currency is LKR (Sri Lankan Rupees). Prices are stored and charged as the
# minor unit (cents), so LKR 850.00 -> Stripe unit_amount 85000.

# --- Stripe ---------------------------------------------------------------
# Secret key (server only). Used to create Checkout Sessions and verify payment
# state. Use test-mode keys while developing; never expose to the browser.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Publishable key. The Checkout Sessions flow redirects to Stripe-hosted UI, so
# this may go unused, but Vercel/Stripe tooling expects it to be present.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Webhook signing secret (whsec_...). Verifies that the webhook payload really
# came from Stripe. Run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and copy the printed value.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- Admin dashboard ------------------------------------------------------
# Used to sign the HttpOnly admin session cookie. Generate a long random string,
# e.g. `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=replace_with_a_long_random_string

# Admin login password. Stored server-side only; never exposed to the browser.
ADMIN_PASSWORD=replace_with_a_strong_password

# --- Owner email notification (Gmail SMTP / app password) -----------------
# After a payment is confirmed by the Stripe webhook, this email is sent. All
# credentials come from here; nothing is hard-coded and nothing is committed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# The Gmail address used to authenticate (must be the same account that issued
# the app password below).
SMTP_USER=bantexsupplies@gmail.com
# A Gmail "App Password" (Account -> Security -> 2-Step Verification -> App
# passwords). NEVER the normal account password. Keep it out of git.
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where the notification email is sent from (optional; defaults to SMTP_USER /
# OWNER_NOTIFICATION_EMAIL).
MAIL_FROM=bantexsupplies@gmail.com

# The owner's inbox that receives each new-order notification.
OWNER_NOTIFICATION_EMAIL=bantexsupplies@gmail.com

# --- Optional -----------------------------------------------------------------
# Order history data file (defaults to data/orders.json). Unnecessary unless you
# deliberately point the app at a different store.
# ORDERS_DATA_FILE=/absolute/path/to/orders.json
