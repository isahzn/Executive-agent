# ── Doc Processor environment variables ─────────────────────────────
# Copy this file to .env and fill in your values. Never commit real
# secrets in this template file — .env is gitignored for a reason.

# OpenRouter API key (https://openrouter.ai/keys)
# Used for AI document extraction. You can also set it inside the app
# (Settings → OpenRouter) — the in-app value wins over this one.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI model to use for extraction (OpenRouter model slug).
# Default: google/gemini-3.1-flash-lite — fast, cheap, and accepts PDFs.
# (OpenAI models on OpenRouter reject PDF file inputs; for PDF extraction use
#  a Gemini or Anthropic model. Change it any time in the app under Settings.)
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Override the OpenRouter API base URL (advanced; proxies/custom gateways).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Secret used to sign JWT session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Backend port (default 5000). The frontend dev server runs on 3000 and
# proxies /api requests here.
PORT=5000

# Frontend origin allowed to call the API (CORS)
CLIENT_ORIGIN=http://localhost:3000

# Where uploaded files + SQLite DB are stored (default: backend/data)
# DATA_DIR=
